# ==============================================================================
# Git Ignore Configuration for Hybraid_QML
# ==============================================================================

# Credentials & Environment Variables (PROTECT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key

# Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Node.js / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases (auto-generated on app startup)
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite

# Large Raw Medical Image Datasets (>14,000 files / ~300MB)
# Note: Sample test images are retained in data/sample_images/ and data/alzheimers/mri_images/
data/benign/
data/malignant/
data/normal/
data/Alzheimer_s Dataset/

# Temporary / Scratch Folders
alzeimers_temp/
qml_repo/
scratch/
.gemini/
.idea/
.vscode/

# OS & Log files
*.log
.DS_Store
Thumbs.db
Desktop.ini
